#lang rhombus/and_meta

// =====================================================================
// Programmart -- concert programs, the program instantiation of facade
// (Art 4), in Rhombus.  Ported from the Programmart used in the tonart
// concert compositions.
//
// The vocabulary (cf. the FARM talk's BNF):
//   section <id> ...      a coordinate: which section a form belongs to
//   art_title "..."       an object: a section's printed title
//   hymn_number n         an object: a hymn by its number in the hymnal
//   bg "color"            an object: a section's background colour
//   program_title "..."   an object: the whole program's title
//   piece <id>            an object: a named piece
//   program_html          a realizer: render the program as an HTML page
// =====================================================================

import:
  facade open
  lib("racket/base.rkt") as rkt        // regexp for parsing a coord string
  lib("racket/string.rkt") as rstr

export:
  section
  art_title text hymn_number bg program_title piece
  program_html program_text
  art_program pick_program rewrite_in_program
  meta:
    expr_section section_of splice_under program_variants program_pick rebuild_art_program
    sections_in_order sections_by_index section_index index_less first_string_in sec_label program_name hymns_in join

// ---------------------------------------------------------------------
// the `section` coordinate -- an ordered id path (like `name`): nesting
// appends, and a form is `within` a section when that section is a prefix
// ---------------------------------------------------------------------

define_coordinate section:
  merge:
    fun (l, r, _l, _r, _c):
      cond
      | l && r:
          block:
            let [a, ...] = args_of(l) ++ args_of(r)
            'section $a ...'
      | ~else: (r || l)
  within:
    fun (l, r, _l, _r, _c):
      def ls = args_of(l).map(fun (a): a.unwrap())
      def rs = args_of(r).map(fun (a): a.unwrap())
      cond
      | rs.length() > ls.length(): #false
      | ~else: (for values(ok = #true) (x in rs, y in ls): ok && x == y)

meta:
  // the section id-path of a form (a list of symbols), or []
  fun expr_section(e):
    def c = context_ref(get_ctxt(e), #'section)
    if c | args_of(c).map(fun (a): a.unwrap()) | []
  // does a form sit in section `secs` (a list of symbols)?
  fun section_of(e, secs): expr_section(e) == secs

// ---------------------------------------------------------------------
// objects
// ---------------------------------------------------------------------

define_object art_title      // art_title "Prelude"  (a section heading)
define_object text           // text "..."  (a line of body prose)
define_object hymn_number    // hymn_number 3
define_object bg             // bg "goldenrod"
define_object program_title  // program_title "PL Songbook"
define_object piece          // piece some-id

// (A hymnal -- mapping hymn numbers to titles and tunes -- belongs to a
// data source outside this library, so `hymn_number_to_title` /
// `hymn_number_to_score` are not defined here.  `hymn_number` is just the
// vocabulary; write a rewriter against your own hymnal to resolve it.)

// ---------------------------------------------------------------------
// realizers
// ---------------------------------------------------------------------

meta:
  // join a list of strings with a separator
  fun join(strs, sep):
    for values(acc = "") (s in strs, i in 0 ..):
      if i == 0 | s | acc +& sep +& s
  // the distinct section id-paths present among the given forms, in
  // first-appearance order
  fun sections_in_order(forms):
    for values(acc = []) (e in forms):
      def s = expr_section(e)
      if s.length() > 0 && !(acc.filter(~keep: fun (x): x == s).length() > 0)
      | acc ++ [s]
      | acc
  // lexicographic `<` on index lists (a shorter prefix sorts first)
  fun index_less(a, b):
    match [a, b]
    | [[], []]: #false
    | [[], _]: #true
    | [_, []]: #false
    | [[ah, ar, ...], [bh, br, ...]]:
        cond
        | ah < bh: #true
        | ah > bh: #false
        | ~else: index_less([ar, ...], [br, ...])
  // the `index` coordinate of section `secs` -- from a form that actually
  // carries one (so a bg overlaid without an index doesn't hide it)
  fun section_index(ctxt, secs):
    def fs = ctxt.filter(~keep: fun (e): section_of(e, secs))
    def indexed = fs.filter(~keep: fun (e): expr_index(e).length() > 0)
    cond
    | indexed.length() > 0: expr_index(indexed[0])
    | fs.length() > 0: expr_index(fs[0])
    | ~else: []
  // the sections in program order -- sorted by their `ix--`/`index`, so a
  // program's declared order (via ix__) is honored
  fun sections_by_index(ctxt):
    def pairs = sections_in_order(ctxt).map(fun (s): [section_index(ctxt, s), s])
    pairs.sort(fun (p, q): index_less(p[0], q[0])).map(fun (p): p[1])
  // the string arg of the first form of type `name` in `secs`, or #false
  fun first_string_in(ctxt, name, secs):
    def fs = context_ref_all(ctxt, name).filter(~keep: fun (e): section_of(e, secs))
    if fs.length() > 0 | args_of(fs[0])[0].unwrap() | #false
  fun sec_label(secs): join(secs.map(fun (s): to_string(s)), ".")
  // the program's title, or #false if it declares none (no default)
  fun program_name(ctxt):
    def t = context_ref(ctxt, #'program_title)
    if t | args_of(t)[0].unwrap() | #false
  fun hymns_in(ctxt, secs):
    context_ref_all(ctxt, #'hymn_number).filter(~keep: fun (e): section_of(e, secs))

// program_text: a plain-text program (title, then each section's title
// and any hymn numbers)
define_realizer program_text:
  fun (ctxt):
    def body:
      for values(acc = "") (secs in sections_in_order(ctxt)):
        def title = first_string_in(ctxt, #'art_title, secs) || sec_label(secs)
        def hymns = hymns_in(ctxt, secs)
        def hymn_line:
          if hymns.length() > 0
          | "  (hymns " +& join(hymns.map(fun (h): to_string(args_of(h)[0].unwrap())), ", ") +& ")"
          | ""
        acc +& "\n" +& sec_label(secs) +& ": " +& title +& hymn_line
    def t = program_name(ctxt)
    (if t | t | "") +& body

// program_html: the program as a self-contained HTML page, each section
// tinted with its `bg`
define_realizer program_html:
  fun (ctxt):
    def title = program_name(ctxt)
    def sections:
      for values(acc = "") (secs in sections_in_order(ctxt)):
        def label = first_string_in(ctxt, #'art_title, secs) || sec_label(secs)
        def color = first_string_in(ctxt, #'bg, secs) || "transparent"
        def hymn_items:
          for values(s = "") (h in hymns_in(ctxt, secs)):
            s +& "<li>Hymn " +& to_string(args_of(h)[0].unwrap()) +& "</li>"
        acc
          +& "  <section style=\"background: " +& color +& "; padding: 1em; margin: .5em 0;\">\n"
          +& "    <h2>" +& label +& "</h2>\n"
          +& (if hymn_items == "" | "" | "    <ul>" +& hymn_items +& "</ul>\n")
          +& "  </section>\n"
    "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>"
      +& (if title | title | "") +& "</title></head>\n<body>\n"
      +& (if title | "  <h1>" +& title +& "</h1>\n" | "")
      +& sections +& "</body></html>\n"

// ---------------------------------------------------------------------
// art_program: one sub-program per realizer, picked by name
// ---------------------------------------------------------------------

// an embedding whose inner is its raw `name: prog` variant clauses
// (stored, not rewritten -- the chosen one is rewritten when picked)
define_embedding art_program:
  fun (expr): body_of(expr)

meta:
  // merge `coords` into each form's own coordinates (section appends, an
  // interval the form already carries is kept)
  fun splice_under(coords, exprs):
    exprs.map(fun (e): set_ctxt(e, merge_coordinates(coords, get_ctxt(e), current_ctxt())))
  // the variant clauses stored inside an art_program
  fun program_variants(ap): ap.group_property(#'inner) || []
  // the program of the clause named `name` (its block body), or #false
  fun program_pick(ap, name):
    def cl = program_variants(ap).filter(~keep: fun (c): head_of(c) == name)
    if cl.length() > 0 | body_of(cl[0]) | #false
  // a fresh art_program holding `variants`, keeping the original's coordinates
  fun rebuild_art_program(ap, variants):
    block:
      let [v, ...] = variants
      set_ctxt('art_program: $v ; ...', get_ctxt(ap))
  // append the rewriters `rs` to one variant clause `name: prog`
  fun inject_into_variant(cl, rs):
    match cl
    | '$(nm :: Identifier): $item; ...':
        block:
          let [it, ...] = [item, ...]
          let [r, ...] = rs
          set_ctxt('$nm: $it ; ... ; $r ; ...', get_ctxt(cl))
    | ~else: cl

// pick_program name: replace each art_program in scope with its `name`
// variant, carrying the art_program's coordinates onto the result
define_mapping_rewriter pick_program over art_program:
  fun (stx, ap):
    def name = args_of(stx)[0].unwrap()
    def chosen = program_pick(ap, name)
    def coords = remove_from_ctxt(get_ctxt(ap), #'art_id)
    if chosen | splice_under(coords, chosen) | []

// rewrite_in_program: <block of rewriters>  -- an art_program stores its
// variants raw (they are rewritten only when a realizer picks one), so we
// cannot run rewriters against notes that do not exist yet.  Instead, append
// the rewriters to every variant's program, so they run when that variant is
// realized.  Mirrors rewrite_in_seq / rewrite_in_music, deferred.
define_mapping_rewriter rewrite_in_program over art_program:
  fun (stx, ap):
    def rs = body_of(stx)
    [rebuild_art_program(ap, program_variants(ap).map(fun (cl): inject_into_variant(cl, rs)))]

// The old process-shared "Enter registry" (register_enter / enter_thunk /
// face_key / coord_key) lived here: it papered over the fact that entering a
// face re-realized stashed source NAMES in a fresh module.  That is retired --
// a face's program is now captured as self-contained source (gestalt's
// coordinate-and-inner-aware nav_children) or reduced by coordinate in one
// module (gestalt-preview's build-nav-wrapper / perform_face), so no name ever
// crosses a module boundary and no registry is needed.
