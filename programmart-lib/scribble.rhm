#lang rhombus/and_meta

// =====================================================================
// programmart -- the Scribble realizer.
//
// `program_scribbler` renders a program as a Scribble document: the title,
// then each section (in ix-- order) as a background-tinted block holding
// its title, its engraved score (tonart4's LilyPond realizer, with any
// `image`s -- e.g. dancer figures -- hung over the staves), and any
// `slide`s.  `render_scribble_html` runs `raco scribble --html` on it.
//
// The realizer is generic: it renders `image` objects, never `arm_diagram`
// directly -- convert poses to images with a rewriter first (as the
// concert does).  It reads `note` / `image` / `slide` / `item` / `code_line`
// by head, so a client's own such forms are handled without importing them.
//
// Bridges programmart + tonart4 (music + engraving), so it is its own
// module rather than the facade-only core.
// =====================================================================

import:
  programmart open
  lib("programmart/resources.rhm") open   // art_program, program_pick
  lib("tonart4/main.rhm") open
  lib("tonart4/lilypond.rhm") open    // engrave, notes_to_staves, ...
  lib("racket/base.rkt") as rkt
  lib("racket/system.rkt") as sys
  lib("racket/file.rkt") as rfile
  lib("racket/path.rkt") as rpath
  meta:
    lib("racket/file.rkt") as mfile
    lib("racket/base.rkt") as mrkt
    lib("programmart/private/scribble-preview.rkt") as mprev   // doc->display-list
    lib("programmart/private/dl-draw.rkt") as mdraw            // display-list->png

export:
  program_scribbler
  render_scribble_html
  programs_to_images
  meta: program_scribble_source render_program_png

meta:
  // section-relative selectors, by head symbol
  fun notes_in(ctxt, secs):
    (context_ref_all(ctxt, #'note) ++ context_ref_all(ctxt, #'music_rest))
      .filter(~keep: fun (e): section_of(e, secs))
  fun images_in(ctxt, secs):
    context_ref_all(ctxt, #'image).filter(~keep: fun (e): section_of(e, secs))
  // the first form of type `name` in `secs`, or #false
  fun first_in(ctxt, name, secs):
    def fs = context_ref_all(ctxt, name).filter(~keep: fun (e): section_of(e, secs))
    if fs.length() > 0 | fs[0] | #false
  fun scripts_in(ctxt, secs):
    context_ref_all(ctxt, #'script).filter(~keep: fun (e): section_of(e, secs))
  // a section's `text` lines (e.g. a resource / hymn title standing in for
  // its contents) -> one Scribble paragraph each
  fun text_in(ctxt, secs):
    context_ref_all(ctxt, #'text).filter(~keep: fun (e): section_of(e, secs))
  fun text_paras(ctxt, secs):
    for values(acc = "") (t in text_in(ctxt, secs)):
      acc +& "@para{" +& esc(args_of(t)[0].unwrap()) +& "}\n"
  // a section's scripts -> Scribble paragraphs: each `line` as
  // "@bold{NAME.} text", each `stage_direction` italicised
  fun script_paras(ctxt, secs):
    for values(acc = "") (sc in scripts_in(ctxt, secs)):
      for values(a = acc) (it in (sc.group_property(#'inner) || [])):
        cond
        | head_of(it) == #'line:
            a +& "@para{@bold{" +& esc(mrkt.#{string-upcase}(to_string(args_of(it)[0].unwrap())))
              +& ".} " +& esc(args_of(it)[1].unwrap()) +& "}\n"
        | head_of(it) == #'stage_direction:
            a +& "@para{@italic{" +& esc(args_of(it)[0].unwrap()) +& "}}\n"
        | ~else: a
  fun slides_in(ctxt, secs):
    context_ref_all(ctxt, #'slide)
      .filter(~keep: fun (e): section_of(e, secs))
      .sort(fun (a, b): index_less(expr_index(a), expr_index(b)))
  fun sec_id(secs): join(secs.map(fun (s): to_string(s)), "-")
  // absolute path for an image reference, so the emitted Scribble document
  // resolves it no matter what directory `raco scribble` is run from (the
  // files are written relative to *this* realize's cwd, which need not be
  // the render cwd)
  fun abspath(p): mrkt.#{path->string}(mrkt.#{path->complete-path}(p))
  // escape Scribble's active characters in body text
  fun esc(s):
    def out = Box("")
    for (ch in to_string(s)):
      def c = to_string(ch)
      out.value := out.value +& (cond | c == "@": "@\"@\"" | c == "{": "@\"{\"" | c == "}": "@\"}\"" | ~else: c)
    out.value
  // escape a string for use as a Racket string literal inside `[...]`
  // (a `@cmd["a" "b"]{body}` bracket arg -- consecutive `{}{}` groups do
  // NOT both reach the call, so titles ride in the brackets, not a group)
  fun slit(s):
    def out = Box("")
    for (ch in to_string(s)):
      def c = to_string(ch)
      out.value := out.value +& (cond | c == "\\": "\\\\" | c == "\"": "\\\"" | ~else: c)
    out.value

  // a `#lang scribble/base` preamble:
  //   @bgsection[color]{title}{body} -- a titled block whose HTML carries
  //     that background colour
  //   @slideframe{title}{body} -- a framed, centered slide card (the
  //     pict-framed slide layout, in HTML)
  fun scribble_preamble():
    "@(require scribble/core scribble/html-properties scribble/base)\n"
      +& "@(define (styled s . body) (nested #:style (style #f (list (attributes (list (cons 'style s))))) body))\n"
      +& "@(define (bgsection color title . body)\n"
      +& "   (styled (string-append \"background-color:\" color \";padding:.5em 1em;margin:.6em 0;border-radius:6px;\")\n"
      +& "     (bold (larger title)) (linebreak) body))\n"
      +& "@(define (slideframe title . body)\n"
      +& "   (styled (string-append \"border:1px solid #888;border-radius:8px;background:#fff;\"\n"
      +& "                          \"box-shadow:0 3px 12px rgba(0,0,0,.18);width:640px;min-height:360px;\"\n"
      +& "                          \"margin:1.4em auto;padding:1.6em 2em;box-sizing:border-box;\")\n"
      +& "     (styled \"font-size:150%;font-weight:bold;text-align:center;border-bottom:2px solid #333;padding-bottom:.3em;margin-bottom:.7em;\" title)\n"
      +& "     body))\n\n"

  // one slide -> Scribble: bold title, bullets, code, and engraved music
  fun slide_scribble(s, dir, tag):
    def content = s.group_property(#'inner) || []
    def items:
      for values(b = "") (e in content):
        cond
        | head_of(e) == #'item || head_of(e) == #'subitem:
            b +& "@item{" +& esc(args_of(e)[0].unwrap()) +& "}\n"
        | ~else: b
    def codes:
      for values(c = "") (e in content):
        if head_of(e) == #'code_line | c +& esc(args_of(e)[0].unwrap()) +& "\n" | c
    def notes = content.filter(~keep: fun (e): head_of(e) == #'note || head_of(e) == #'music_rest)
    def music:
      if notes.length() > 0
      | (block:
           def png = engrave_cropped(ly_document_staves(notes_to_staves(notes)), dir, tag, "png")
           "@image[\"" +& abspath(png) +& "\"]{score}\n")
      | ""
    "@slideframe[\"" +& slit(args_of(s)[0].unwrap()) +& "\"]{\n"
      +& (if items == "" | "" | "@itemlist[" +& items +& "]\n")
      +& (if codes == "" | "" | "@verbatim{\n" +& codes +& "}\n")
      +& music +& "}\n"

meta:
  // build the `#lang scribble/base` document string for a program `ctxt`,
  // engraving its scores under `dir`.  Exposed so other realizers (e.g.
  // gestalt's, embedding a program on a shape's face) can render a program
  // without going through the `program_scribbler` realizer form.
  fun program_scribble_source(ctxt, dir):
    mfile.#{make-directory*}(dir)
    def title = program_name(ctxt)
    def all_secs = sections_by_index(ctxt)
    // engrave every section's score up front, in ONE parallel batch (each
    // lilypond run is independent), then look the PNGs up while building the
    // document -- much faster than one lilypond process per section
    def note_secs = all_secs.filter(~keep: fun (secs): notes_in(ctxt, secs).length() > 0)
    def jobs = for List (secs in note_secs):
      def notes = notes_in(ctxt, secs)
      def imgs = images_in(ctxt, secs)
      def [bar_len, time_str] = time_sig_info(first_in(ctxt, #'time_sig, secs))
      [ly_document_staves(notes_to_staves(notes, bar_len, imgs, time_str)), dir, sec_id(secs)]
    def pngs = engrave_cropped_all(jobs)
    // pngs are in note_secs order; walk sections and pull the next one for
    // each that has a score
    def png_i = Box(0)
    def blocks:
      for values(acc = "") (secs in all_secs):
        def label = first_string_in(ctxt, #'art_title, secs) || sec_label(secs)
        def color = first_string_in(ctxt, #'bg, secs) || "transparent"
        def imgs = images_in(ctxt, secs)
        // a section with notes: its (already engraved) score.  a section
        // without: its images stand alone (e.g. slide pictures), each on its
        // own line.
        def body:
          if notes_in(ctxt, secs).length() > 0
          | (block:
               def p = pngs[png_i.value]
               png_i.value := png_i.value + 1
               "@image[\"" +& abspath(p) +& "\"]{score}\n")
          | (for values(a = "") (im in imgs):
               a +& "@image[\"" +& abspath(expr_image(im)) +& "\"]{slide}\n@linebreak[]\n")
        // the spoken script leads the section, then any `text` lines
        // (resource / hymn titles), then its score/slides
        acc +& "@bgsection[\"" +& color +& "\" \"" +& slit(label) +& "\"]{\n"
          +& script_paras(ctxt, secs) +& text_paras(ctxt, secs) +& body +& "}\n\n"
    "#lang scribble/base\n\n" +& scribble_preamble()
      +& (if title | "@title{" +& esc(title) +& "}\n\n" | "")
      +& blocks

define_realizer program_scribbler:
  fun (ctxt): program_scribble_source(ctxt, "program-scores")

// `raco` next to the running `racket` (falls back to PATH)
fun raco_cmd():
  def r = rkt.#{find-executable-path}(rkt.#{find-system-path}(rkt.#{string->symbol}("exec-file")))
  if r
  | rkt.#{path->string}(rkt.#{build-path}(rpath.#{path-only}(r), "raco"))
  | "raco"

// render Scribble `source` to `dir/name.html` (runtime); returns the path
fun render_scribble_html(source, dir, name):
  rfile.#{make-directory*}(dir)
  def scrbl = dir +& "/" +& name +& ".scrbl"
  def f = rkt.#{open-output-file}(scrbl, ~exists: #'replace)
  rkt.#{write-string}(source, f)
  rkt.#{close-output-port}(f)
  sys.#{system}("\"" +& raco_cmd() +& "\" scribble --dest " +& dir +& " " +& scrbl)
  dir +& "/" +& name +& ".html"

// ---------------------------------------------------------------------
// programs_to_images: render an embedded program to a PNG picture of it,
// so a shape realizer (gestalt) can hang it on a face.  Each `art_program`
// in scope is realized with the scribble realizer, that document is
// rendered to HTML and shot to a PNG by headless Chrome, and the
// art_program is replaced by an `image` (carrying its coordinates -- e.g.
// gestalt's `name`/`face`).  Everything runs at rewrite time, like the
// other image rewriters.
// ---------------------------------------------------------------------

meta:
  // scribble `source` -> a PNG of the rendered program; returns its path.
  // Write the source to a temp `.scrbl`, take its `doc` (no raco/browser --
  // a `#lang scribble/base` module just provides `doc`), turn it into the
  // display list `scribble-preview` builds, and paint that into a bitmap
  // with `dl-draw` (gui-free racket/draw).  Sized exactly to the program.
  fun render_program_png(source, dir, name):
    mfile.#{make-directory*}(dir)
    def scrbl = dir +& "/" +& name +& ".scrbl"
    def f = mrkt.#{open-output-file}(scrbl, ~exists: #'replace)
    mrkt.#{write-string}(source, f)
    mrkt.#{close-output-port}(f)
    def doc = mrkt.#{dynamic-require}(mrkt.#{string->path}(scrbl), #'doc, fun (): #false)
    def png = mrkt.#{path->string}(mrkt.#{path->complete-path}(dir +& "/" +& name +& ".png"))
    if doc
    | mdraw.#{display-list->png}(mprev.#{doc->display-list}(doc), png)
    | png
  // a stable file name from the art_program's own coordinates
  fun program_tag(ap):
    def nm = join(expr_names(ap).map(fun (n): to_string(n)), "-")
    "embed-" +& (if nm == "" | "prog" | nm) +& "-" +& Symbol.gen()

define_mapping_rewriter programs_to_images over art_program:
  fun (stx, ap):
    def sub = program_pick(ap, #'html)          // the printable variant
    if sub
    | (block:
         def sctxt = rewrite(sub)
         def png = render_program_png(program_scribble_source(sctxt, "gestalt-embeds"),
                                      "gestalt-embeds", program_tag(ap))
         def path = Syntax.make(png)
         [set_ctxt('image $path', remove_from_ctxt(get_ctxt(ap), #'art_id))])
    | []
