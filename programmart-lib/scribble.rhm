#lang rhombus/and_meta

// =====================================================================
// programmart -- the Scribble realizer.
//
// `program_scribble` renders a program as a Scribble document: the title,
// then each section (in ix-- order) as a background-tinted block holding
// its title, its engraved score (tonart4's LilyPond realizer, with any
// `image`s -- e.g. dancer figures -- hung over the staves), and any
// `slide`s.  `render_scribble_html` runs `raco scribble --html` on it.
//
// The realizer is generic: it renders `image` objects, never `arm_diagram`
// directly -- convert poses to images with a rewriter first (as the
// concert does).  It reads `note` / `image` / `slide` / `item` / `code_line`
// by head, so a client's own such forms are handled without importing them.
//
// Bridges programmart + tonart4 (music + engraving), so it is its own
// module rather than the facade-only core.
// =====================================================================

import:
  programmart open
  lib("tonart4/main.rhm") open
  lib("tonart4/lilypond.rhm") open    // engrave, notes_to_staves, ...
  lib("racket/base.rkt") as rkt
  lib("racket/system.rkt") as sys
  lib("racket/file.rkt") as rfile
  lib("racket/path.rkt") as rpath
  meta:
    lib("racket/file.rkt") as mfile
    lib("racket/base.rkt") as mrkt

export:
  program_scribble
  render_scribble_html

meta:
  // section-relative selectors, by head symbol
  fun notes_in(ctxt, secs):
    (context_ref_all(ctxt, #'note) ++ context_ref_all(ctxt, #'music_rest))
      .filter(~keep: fun (e): section_of(e, secs))
  fun images_in(ctxt, secs):
    context_ref_all(ctxt, #'image).filter(~keep: fun (e): section_of(e, secs))
  fun slides_in(ctxt, secs):
    context_ref_all(ctxt, #'slide)
      .filter(~keep: fun (e): section_of(e, secs))
      .sort(fun (a, b): index_less(expr_index(a), expr_index(b)))
  fun sec_id(secs): join(secs.map(fun (s): to_string(s)), "-")
  // absolute path for an image reference, so the emitted Scribble document
  // resolves it no matter what directory `raco scribble` is run from (the
  // files are written relative to *this* realize's cwd, which need not be
  // the render cwd)
  fun abspath(p): mrkt.#{path->string}(mrkt.#{path->complete-path}(p))
  // escape Scribble's active characters in body text
  fun esc(s):
    def out = Box("")
    for (ch in to_string(s)):
      def c = to_string(ch)
      out.value := out.value +& (cond | c == "@": "@\"@\"" | c == "{": "@\"{\"" | c == "}": "@\"}\"" | ~else: c)
    out.value

  // a `#lang scribble/base` preamble:
  //   @bgsection[color]{title}{body} -- a titled block whose HTML carries
  //     that background colour
  //   @slideframe{title}{body} -- a framed, centered slide card (the
  //     pict-framed slide layout, in HTML)
  fun scribble_preamble():
    "@(require scribble/core scribble/html-properties scribble/base)\n"
      +& "@(define (styled s . body) (nested #:style (style #f (list (attributes (list (cons 'style s))))) body))\n"
      +& "@(define (bgsection color title . body)\n"
      +& "   (styled (string-append \"background:\" color \";padding:.5em 1em;margin:.6em 0;border-radius:6px;\")\n"
      +& "     (bold (larger title)) (linebreak) body))\n"
      +& "@(define (slideframe title . body)\n"
      +& "   (styled (string-append \"border:1px solid #888;border-radius:8px;background:#fff;\"\n"
      +& "                          \"box-shadow:0 3px 12px rgba(0,0,0,.18);width:640px;min-height:360px;\"\n"
      +& "                          \"margin:1.4em auto;padding:1.6em 2em;box-sizing:border-box;\")\n"
      +& "     (styled \"font-size:150%;font-weight:bold;text-align:center;border-bottom:2px solid #333;padding-bottom:.3em;margin-bottom:.7em;\" title)\n"
      +& "     body))\n\n"

  // one slide -> Scribble: bold title, bullets, code, and engraved music
  fun slide_scribble(s, dir, tag):
    def content = s.group_property(#'inner) || []
    def items:
      for values(b = "") (e in content):
        cond
        | head_of(e) == #'item || head_of(e) == #'subitem:
            b +& "@item{" +& esc(args_of(e)[0].unwrap()) +& "}\n"
        | ~else: b
    def codes:
      for values(c = "") (e in content):
        if head_of(e) == #'code_line | c +& esc(args_of(e)[0].unwrap()) +& "\n" | c
    def notes = content.filter(~keep: fun (e): head_of(e) == #'note || head_of(e) == #'music_rest)
    def music:
      if notes.length() > 0
      | (block:
           def png = engrave(ly_document_staves(notes_to_staves(notes)), dir, tag, "png")
           "@image[\"" +& png +& "\"]{score}\n")
      | ""
    "@slideframe{" +& esc(args_of(s)[0].unwrap()) +& "}{\n"
      +& (if items == "" | "" | "@itemlist[" +& items +& "]\n")
      +& (if codes == "" | "" | "@verbatim{\n" +& codes +& "}\n")
      +& music +& "}\n"

define_realizer program_scribble:
  fun (ctxt):
    def dir = "program-scores"
    mfile.#{make-directory*}(dir)
    def title = program_name(ctxt)
    def blocks:
      for values(acc = "") (secs in sections_by_index(ctxt)):
        def label = first_string_in(ctxt, #'art_title, secs) || sec_label(secs)
        def color = first_string_in(ctxt, #'bg, secs) || "transparent"
        def notes = notes_in(ctxt, secs)
        def imgs = images_in(ctxt, secs)
        // a section with notes: one engraved score, its images hung over
        // the staves.  a section without: its images stand alone (e.g. slide
        // pictures), each on its own line.
        def body:
          if notes.length() > 0
          | (block:
               def src = ly_document_staves(notes_to_staves(notes, 4, imgs))
               def png = engrave(src, dir, sec_id(secs), "png")
               "@image[\"" +& abspath(png) +& "\"]{score}\n")
          | (for values(a = "") (im in imgs):
               a +& "@image[\"" +& abspath(expr_image(im)) +& "\"]{slide}\n@linebreak[]\n")
        acc +& "@bgsection[\"" +& color +& "\"]{" +& esc(label) +& "}{\n"
          +& body +& "}\n\n"
    "#lang scribble/base\n\n" +& scribble_preamble() +& "@title{" +& esc(title) +& "}\n\n" +& blocks

// `raco` next to the running `racket` (falls back to PATH)
fun raco_cmd():
  def r = rkt.#{find-executable-path}(rkt.#{find-system-path}(rkt.#{string->symbol}("exec-file")))
  if r
  | rkt.#{path->string}(rkt.#{build-path}(rpath.#{path-only}(r), "raco"))
  | "raco"

// render Scribble `source` to `dir/name.html` (runtime); returns the path
fun render_scribble_html(source, dir, name):
  rfile.#{make-directory*}(dir)
  def scrbl = dir +& "/" +& name +& ".scrbl"
  def f = rkt.#{open-output-file}(scrbl, ~exists: #'replace)
  rkt.#{write-string}(source, f)
  rkt.#{close-output-port}(f)
  sys.#{system}("\"" +& raco_cmd() +& "\" scribble --dest " +& dir +& " " +& scrbl)
  dir +& "/" +& name +& ".html"
