#lang rhombus/and_meta

// =====================================================================
// programmart -- the Scribble realizer.
//
// `program_scribbler` renders a program as a Scribble document: the title,
// then each section (in ix-- order) as a background-tinted block holding
// its title, its engraved score (tonart4's LilyPond realizer, with any
// `image`s -- e.g. dancer figures -- hung over the staves), and any
// `slide`s.  `render_scribble_html` runs `raco scribble --html` on it.
//
// The realizer is generic: it renders `image` objects, never `arm_diagram`
// directly -- convert poses to images with a rewriter first (as the
// concert does).  It reads `note` / `image` / `slide` / `item` / `code_line`
// by head, so a client's own such forms are handled without importing them.
//
// Bridges programmart + tonart4 (music + engraving), so it is its own
// module rather than the facade-only core.
// =====================================================================

import:
  programmart open
  lib("programmart/resources.rhm") open   // art_program, program_pick
  lib("tonart4/main.rhm") open
  lib("tonart4/lilypond.rhm") open    // engrave, notes_to_staves, ...
  lib("racket/base.rkt") as rkt
  lib("racket/system.rkt") as sys
  lib("racket/file.rkt") as rfile
  lib("racket/path.rkt") as rpath
  meta:
    lib("racket/file.rkt") as mfile
    lib("racket/base.rkt") as mrkt
    lib("programmart/private/scribble-preview.rkt") as mprev   // doc->display-list
    lib("programmart/private/dl-draw.rkt") as mdraw            // display-list->png

export:
  program_scribbler
  render_scribble_html
  programs_to_images nav_views
  meta: program_scribble_source render_program_png

meta:
  // section-relative selectors, by head symbol.  These read *nested* -- a
  // note held inside a `music` embedding counts, since that is how music is
  // organized (see facade's context_ref_all_nested).
  fun notes_in(ctxt, secs):
    (context_ref_all_nested(ctxt, #'note) ++ context_ref_all_nested(ctxt, #'music_rest))
      .filter(~keep: fun (e): section_of(e, secs))
  fun images_in(ctxt, secs):
    context_ref_all(ctxt, #'image).filter(~keep: fun (e): section_of(e, secs))
  // the first form of type `name` in `secs`, or #false
  fun first_in(ctxt, name, secs):
    def fs = context_ref_all(ctxt, name).filter(~keep: fun (e): section_of(e, secs))
    if fs.length() > 0 | fs[0] | #false
  fun scripts_in(ctxt, secs):
    context_ref_all(ctxt, #'script).filter(~keep: fun (e): section_of(e, secs))
  // the `music` embeddings in a section (each an ix__ item that may carry an
  // `index`), so a score can be placed at its own position among the scripts
  fun musics_in(ctxt, secs):
    context_ref_all(ctxt, #'music).filter(~keep: fun (e): section_of(e, secs))
  // a section's `text` lines (e.g. a resource / hymn title standing in for
  // its contents) -> one Scribble paragraph each
  fun text_in(ctxt, secs):
    context_ref_all(ctxt, #'text).filter(~keep: fun (e): section_of(e, secs))
  fun text_paras(ctxt, secs):
    for values(acc = "") (t in text_in(ctxt, secs)):
      acc +& "@para{" +& esc(args_of(t)[0].unwrap()) +& "}\n"
  // a thick horizontal rule under a resource heading (old programmart's look).
  // The preview renderer draws a heavy line for an empty paragraph whose style
  // NAME is "TonartRule" (see scribble-preview.rkt); the CSS attribute covers
  // HTML output too.
  fun rules_in(ctxt, secs):
    def rs = context_ref_all(ctxt, #'program_rule).filter(~keep: fun (e): section_of(e, secs))
    for values(acc = "") (r in rs):
      acc +& "@para[#:style rule-style]{}\n"
  // a section's scripts -> Scribble paragraphs: each `line` as
  // "@bold{NAME.} text", each `stage_direction` italicised
  // one script block -> its Scribble paragraphs
  fun script_block_paras(sc):
    for values(a = "") (it in (sc.group_property(#'inner) || [])):
      cond
      | head_of(it) == #'line:
          a +& "@para{@bold{" +& esc(mrkt.#{string-upcase}(to_string(args_of(it)[0].unwrap())))
            +& ".} " +& esc(args_of(it)[1].unwrap()) +& "}\n"
      | head_of(it) == #'stage_direction:
          a +& "@para{@italic{" +& esc(args_of(it)[0].unwrap()) +& "}}\n"
      | ~else: a
  fun script_paras(ctxt, secs):
    for values(acc = "") (sc in scripts_in(ctxt, secs)):
      acc +& script_block_paras(sc)
  fun slides_in(ctxt, secs):
    context_ref_all(ctxt, #'slide)
      .filter(~keep: fun (e): section_of(e, secs))
      .sort(fun (a, b): index_less(expr_index(a), expr_index(b)))
  fun sec_id(secs):
    def s = join(secs.map(fun (s): to_string(s)), "-")
    if s == "" | "score" | s      // the no-section group needs a real file name
  // absolute path for an image reference, so the emitted Scribble document
  // resolves it no matter what directory `raco scribble` is run from (the
  // files are written relative to *this* realize's cwd, which need not be
  // the render cwd)
  fun abspath(p): mrkt.#{path->string}(mrkt.#{path->complete-path}(p))
  // escape Scribble's active characters in body text
  fun esc(s):
    def out = Box("")
    for (ch in to_string(s)):
      def c = to_string(ch)
      out.value := out.value +& (cond | c == "@": "@\"@\"" | c == "{": "@\"{\"" | c == "}": "@\"}\"" | ~else: c)
    out.value
  // escape a string for use as a Racket string literal inside `[...]`
  // (a `@cmd["a" "b"]{body}` bracket arg -- consecutive `{}{}` groups do
  // NOT both reach the call, so titles ride in the brackets, not a group)
  fun slit(s):
    def out = Box("")
    for (ch in to_string(s)):
      def c = to_string(ch)
      out.value := out.value +& (cond | c == "\\": "\\\\" | c == "\"": "\\\"" | ~else: c)
    out.value
  // is a rendered body only whitespace? (used to drop empty / bg-only sections)
  fun is_blank(s):
    for values(blank = #true) (ch in to_string(s)):
      def c = to_string(ch)
      if c == " " || c == "\n" || c == "\t" || c == "\r"
      | blank
      | #false

  // a `#lang scribble/base` preamble:
  //   @bgsection[color]{title}{body} -- a titled block whose HTML carries
  //     that background colour
  //   @slideframe{title}{body} -- a framed, centered slide card (the
  //     pict-framed slide layout, in HTML)
  fun scribble_preamble():
    "@(require scribble/core scribble/html-properties scribble/base)\n"
      +& "@(define rule-style (make-style \"TonartRule\" (list (attributes (list (cons 'style \"border-top:3px solid #000;margin:.4em 0;\"))))))\n"
      +& "@(define (styled s . body) (nested #:style (style #f (list (attributes (list (cons 'style s))))) body))\n"
      +& "@(define sectitle-style (make-style #f (list (list 'tonart-colored-title 1))))\n"
      +& "@(define (bgsection color title . body)\n"
      +& "   (apply styled (string-append \"background-color:\" color \";padding:.5em 1em;margin:.6em 0;border-radius:6px;\")\n"
      +& "     (if title (cons (paragraph sectitle-style (bold (larger title))) body) body)))\n"
      +& "@(define (slideframe title . body)\n"
      +& "   (styled (string-append \"border:1px solid #888;border-radius:8px;background:#fff;\"\n"
      +& "                          \"box-shadow:0 3px 12px rgba(0,0,0,.18);width:640px;min-height:360px;\"\n"
      +& "                          \"margin:1.4em auto;padding:1.6em 2em;box-sizing:border-box;\")\n"
      +& "     (styled \"font-size:150%;font-weight:bold;text-align:center;border-bottom:2px solid #333;padding-bottom:.3em;margin-bottom:.7em;\" title)\n"
      +& "     body))\n\n"

  // one slide -> Scribble: bold title, bullets, code, and engraved music
  fun slide_scribble(s, dir, tag):
    def content = s.group_property(#'inner) || []
    def items:
      for values(b = "") (e in content):
        cond
        | head_of(e) == #'item || head_of(e) == #'subitem:
            b +& "@item{" +& esc(args_of(e)[0].unwrap()) +& "}\n"
        | ~else: b
    def codes:
      for values(c = "") (e in content):
        if head_of(e) == #'code_line | c +& esc(args_of(e)[0].unwrap()) +& "\n" | c
    def notes = context_ref_all_nested(content, #'note) ++ context_ref_all_nested(content, #'music_rest)
    def music:
      if notes.length() > 0
      | (block:
           def png = engrave_cropped(ly_document_staves(notes_to_staves(notes)), dir, tag, "png")
           "@image[\"" +& abspath(png) +& "\"]{score}\n")
      | ""
    "@slideframe[\"" +& slit(args_of(s)[0].unwrap()) +& "\"]{\n"
      +& (if items == "" | "" | "@itemlist[" +& items +& "]\n")
      +& (if codes == "" | "" | "@verbatim{\n" +& codes +& "}\n")
      +& music +& "}\n"

meta:
  // build the `#lang scribble/base` document string for a program `ctxt`,
  // engraving its scores under `dir`.  Exposed so other realizers (e.g.
  // gestalt's, embedding a program on a shape's face) can render a program
  // without going through the `program_scribbler` realizer form.
  fun program_scribble_source(ctxt, dir):
    mfile.#{make-directory*}(dir)
    def title = program_name(ctxt)
    // the sections in program order, plus the "no section" group ([]) when
    // there is section-less music (e.g. a bare `music:` embedded on a shape's
    // face) -- so a program need not declare a section just to show a score
    def all_secs:
      def secs = sections_by_index(ctxt)
      if notes_in(ctxt, []).length() > 0 | [[]] ++ secs | secs
    // engrave every section's score up front, in ONE parallel batch (each
    // lilypond run is independent), then look the PNGs up while building the
    // document -- much faster than one lilypond process per section
    def note_secs = all_secs.filter(~keep: fun (secs): notes_in(ctxt, secs).length() > 0)
    def jobs = for List (secs in note_secs):
      def notes = notes_in(ctxt, secs)
      def imgs = images_in(ctxt, secs)
      def [bar_len, time_str] = time_sig_info(first_in(ctxt, #'time_sig, secs))
      [ly_document_staves(notes_to_staves(notes, bar_len, imgs, time_str)), dir, sec_id(secs)]
    def pngs = engrave_cropped_all(jobs)
    // pngs are in note_secs order; walk sections and pull the next one for
    // each that has a score
    def png_i = Box(0)
    def big = 1000000000
    // an item's full `index` path (from ix__), or [big] when unindexed so it
    // sorts after indexed items (index_less puts [] first, not last)
    fun idx_key(e):
      def ix = expr_index(e)
      if ix.length() > 0 | ix | [big]
    def blocks:
      for values(acc = "") (secs in all_secs):
        // no `art_title` -> no title rendered at all (no coordinate-name
        // fallback); the `@bgsection` below is handed `#f` and omits the heading
        def label = first_string_in(ctxt, #'art_title, secs)
        def color = first_string_in(ctxt, #'bg, secs) || "transparent"
        def imgs = images_in(ctxt, secs)
        // the section's score image (its already-engraved notes), keyed by its
        // `music` embedding's index so it can sit between script blocks the way
        // art3's `the-script` interleaved (output (! opening)) after a speak
        def score_piece:
          if notes_in(ctxt, secs).length() > 0
          | (block:
               def p = pngs[png_i.value]
               png_i.value := png_i.value + 1
               def ms = musics_in(ctxt, secs)
               def k = if ms.length() > 0 | idx_key(ms[0]) | [big]
               [[k, "@image[\"" +& abspath(p) +& "\"]{score}\n"]])
          | (block:
               def slides = for values(a = "") (im in imgs):
                 a +& "@image[\"" +& abspath(expr_image(im)) +& "\"]{slide}\n@linebreak[]\n"
               if slides == "" | [] | [[[big], slides]])
        // one piece per script block (so the score can fall between them),
        // then text lines and rules; interleave all by index, unindexed last
        def script_pieces = for List (sc in scripts_in(ctxt, secs)):
          [idx_key(sc), script_block_paras(sc)]
        def tail_pieces = [[[big], text_paras(ctxt, secs) +& rules_in(ctxt, secs)]]
        def all_pieces = script_pieces ++ tail_pieces ++ score_piece
        def tagged = for List (i in 0 .. all_pieces.length()):
          [all_pieces[i][0], i, all_pieces[i][1]]
        def sorted = tagged.sort(fun (a, b):
                                   cond
                                   | index_less(a[0], b[0]): #true
                                   | index_less(b[0], a[0]): #false
                                   | ~else: a[1] < b[1])
        def body = for values(a = "") (t in sorted): a +& t[2]
        // a section with no body -- no score, scripts, slides, text or rules --
        // is not rendered at all, even if it carries a `bg` (a colour overlaid
        // on a section absent from THIS program must not draw an empty tinted
        // block) or a title.
        cond
        | is_blank(body): acc
        | ~else:
            def title_arg = if label | "\"" +& slit(label) +& "\"" | "#f"
            acc +& "@bgsection[\"" +& color +& "\" " +& title_arg +& "]{\n"
              +& body +& "}\n\n"
    "#lang scribble/base\n\n" +& scribble_preamble()
      +& (if title | "@title{" +& esc(title) +& "}\n\n" | "")
      +& blocks

define_realizer program_scribbler:
  fun (ctxt): program_scribble_source(ctxt, "program-scores")

// `raco` next to the running `racket` (falls back to PATH)
fun raco_cmd():
  def r = rkt.#{find-executable-path}(rkt.#{find-system-path}(rkt.#{string->symbol}("exec-file")))
  if r
  | rkt.#{path->string}(rkt.#{build-path}(rpath.#{path-only}(r), "raco"))
  | "raco"

// render Scribble `source` to `dir/name.html` (runtime); returns the path
fun render_scribble_html(source, dir, name):
  rfile.#{make-directory*}(dir)
  def scrbl = dir +& "/" +& name +& ".scrbl"
  def f = rkt.#{open-output-file}(scrbl, ~exists: #'replace)
  rkt.#{write-string}(source, f)
  rkt.#{close-output-port}(f)
  sys.#{system}("\"" +& raco_cmd() +& "\" scribble --dest " +& dir +& " " +& scrbl)
  dir +& "/" +& name +& ".html"

// ---------------------------------------------------------------------
// programs_to_images: render an embedded program to a PNG picture of it,
// so a shape realizer (gestalt) can hang it on a face.  Each `art_program`
// in scope is realized with the scribble realizer, that document is
// rendered to HTML and shot to a PNG by headless Chrome, and the
// art_program is replaced by an `image` (carrying its coordinates -- e.g.
// gestalt's `name`/`face`).  Everything runs at rewrite time, like the
// other image rewriters.
// ---------------------------------------------------------------------

meta:
  // scribble `source` -> a PNG of the rendered program; returns its path.
  // Write the source to a temp `.scrbl`, take its `doc` (no raco/browser --
  // a `#lang scribble/base` module just provides `doc`), turn it into the
  // display list `scribble-preview` builds, and paint that into a bitmap
  // with `dl-draw` (gui-free racket/draw).  Sized exactly to the program.
  // a content hash of `s`, so the same source names the same file -- the basis
  // of the render cache (drilling into nested programs must not repaint the
  // same unchanged program every time)
  fun content_hash(s):
    to_string(s.length()) +& "x" +& to_string(mrkt.#{abs}(mrkt.#{equal-hash-code}(s)))
  fun render_program_png(source, dir, prefix):
    mfile.#{make-directory*}(dir)
    def name = prefix +& "-" +& content_hash(source)
    def png = mrkt.#{path->string}(mrkt.#{path->complete-path}(dir +& "/" +& name +& ".png"))
    cond
    | mrkt.#{file-exists?}(png): png            // cached: this exact source is drawn
    | ~else:
        // ABSOLUTE path: `open-output-file` writes relative to `current-directory`
        // but `dynamic-require` resolves a relative path against
        // `current-load-relative-directory` -- the preview sets those to different
        // dirs, so a relative scrbl is written one place and looked for in another
        // ("cannot find file ...scrbl").  A complete path is unambiguous for both.
        def scrbl = mrkt.#{path->complete-path}(dir +& "/" +& name +& ".scrbl")
        def f = mrkt.#{open-output-file}(scrbl, ~exists: #'replace)
        mrkt.#{write-string}(source, f)
        mrkt.#{close-output-port}(f)
        def doc = mrkt.#{dynamic-require}(scrbl, #'doc, fun (): #false)
        if doc
        | mdraw.#{display-list->png}(mprev.#{doc->display-list}(doc), png)
        | png
  // a stable prefix from the art_program's own coordinates (the content hash
  // is appended by render_program_png)
  fun program_tag(ap):
    def nm = join(expr_names(ap).map(fun (n): to_string(n)), "-")
    "embed-" +& (if nm == "" | "prog" | nm)

  // Make a stashed program SELF-CONTAINED by running the real engine over each
  // variant body.  A face whose body is a section name (`art_program: html:
  // demo_intro`) otherwise stashes just that name (and any art-var nested under
  // it, e.g. a `fanfare` under `music`); the preview's Enter path then rebuilds
  // a fresh module and re-realizes those names, where the section arts may not
  // be in scope ("unknown art form: ..."").  `rewrite` splices art-vars AND
  // re-compiles embeddings here (we are in an expansion context), leaving a
  // concrete program of notes/scripts that needs no name resolution downstream.
  fun flatten_variants(variants):
    for List (cl in variants):
      match cl
      | '$(nm :: Identifier): $item; ...':
          block:
            let [f, ...] = rewrite([item, ...])
            set_ctxt('$nm: $f ; ...', get_ctxt(cl))
      | ~else: cl

define_mapping_rewriter programs_to_images over art_program:
  fun (stx, ap):
    def sub = program_pick(ap, #'html)          // the printable variant
    if sub
    | (block:
         def sctxt = rewrite(sub)
         def png = render_program_png(program_scribble_source(sctxt, "gestalt-embeds"),
                                      "gestalt-embeds", program_tag(ap))
         def path = Syntax.make(png)
         // stash the program's variants (art-vars expanded to concrete forms)
         // on the image, so a viewer (the gestalt preview) can recover and
         // *perform* this face's program later -- see gestalt's `perform_face`
         def img = set_ctxt('image $path', remove_from_ctxt(get_ctxt(ap), #'art_id))
         [img.group_property(#'program_source, flatten_variants(program_variants(ap)), #true)])
    | []

// ---------------------------------------------------------------------
// nav_views: render EVERY face in scope to its scribble document, in ONE pass,
// keyed by its coordinate selector.  The scene is spliced once (to reach this
// context) and each face rendered from it -- O(faces), NOT the O(faces^2) of
// reducing the whole scene to one face at a time.  A face is either a raw
// `art_program` or an `image` that programs_to_images drew (its html stashed as
// `program_source`), so this reads whichever `program_visual` has.  Returns a
// readable `((SELECTOR DOC) ...)`.
// ---------------------------------------------------------------------

meta:
  // a face's coordinates as a readable selector string
  fun nav_coord_text(c):
    def parts = args_of(c).map(fun (a): to_string(a.unwrap()))
    to_string(head_of(c)) +& (if parts.length() > 0 | " " +& join(parts, " ") | "")
  fun nav_selector(e):
    def cs = get_ctxt(e).filter(~keep: fun (c): to_string(head_of(c)) != "art_id")
    join(cs.map(nav_coord_text), ", ")
  // a scheme-readable escaped string literal
  fun nav_sval(s):
    def out = Box("\"")
    for (ch in to_string(s)):
      def c = to_string(ch)
      out.value := out.value +& (cond | c == "\\": "\\\\" | c == "\"": "\\\"" | ~else: c)
    out.value +& "\""
  // the `html` variant body of a face, whether it is a raw art_program (its
  // `inner` variant clauses) or a drawn image (its stashed `program_source`
  // clauses) -- the same clauses either way, so a face reads uniformly
  fun face_html(e):
    def variants = e.group_property(#'program_source) || (e.group_property(#'inner) || [])
    for values(p = []) (c in variants):
      if to_string(head_of(c)) == "html" | body_of(c) | p
  // the faces in scope: raw art_programs and/or the images they were drawn to
  fun faces_in(ctxt):
    context_ref_all(ctxt, #'art_program) ++ context_ref_all(ctxt, #'image)

define_realizer nav_views:
  fun (ctxt):
    def rows = for values(acc = []) (e in faces_in(ctxt)):
      def html = face_html(e)
      cond
      | html.length() > 0:
          def doc = program_scribble_source(rewrite(html), "gestalt-embeds")
          acc ++ ["(" +& nav_sval(nav_selector(e)) +& " " +& nav_sval(doc) +& ")"]
      | ~else: acc
    "(" +& join(rows, "\n ") +& ")"
