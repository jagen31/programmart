#lang rhombus/and_meta

// =====================================================================
// programmart -- the audio realizer.
//
// `program_performer` renders a program into a flat *timeline* of playable
// instructions, in section order -- the same idea as the tonart concert's
// `program-chuck-realizer`, but producing rsound thunks instead of ChucK
// source, so an ordinary player can walk it:
//
//   PairList("mark",   "Prelude")
//   PairList("speak",  "PRESENTER", "Welcome to my Art demo!")
//   PairList("direct", "the audience rises")
//   PairList("music",  <thunk: () -> rsound>, 8.0)          // 8.0 seconds
//
// The timeline is plain data (a Racket list, for a Racket player), so the
// thing that plays it -- playing each music thunk's rsound and speaking
// each line with `say` -- is ordinary code with no sound card near the
// macro level.  Music is a *thunk* so a section is synthesized only when
// the player reaches it, not all up front.
//
// Expects the program already reduced to `tone`s (its notes converted, as
// `program_audio` does), each carrying its section; the performer groups
// them by section and mixes each section with `rs_render`.
// =====================================================================

import:
  programmart open
  lib("tonart4/main.rhm") open        // rs_render, tone, ...
  meta:
    lib("racket/base.rkt") as mrkt

export:
  program_performer nav_audios

meta:
  // read nested: tones live inside `music` embeddings (see facade's
  // context_ref_all_nested), so descend to find them, like the engraver
  fun tones_in(ctxt, secs):
    context_ref_all_nested(ctxt, #'tone).filter(~keep: fun (e): section_of(e, secs))
  fun scripts_in(ctxt, secs):
    context_ref_all(ctxt, #'script).filter(~keep: fun (e): section_of(e, secs))
  // the `music` embeddings in a section (each an ix__ item that may carry an
  // `index`), so their tones can be played as their own event, in order
  fun musics_in(ctxt, secs):
    context_ref_all(ctxt, #'music).filter(~keep: fun (e): section_of(e, secs))
  fun tones_of(m):
    context_ref_all_nested([m], #'tone)
  // slide images in a section, in slide order (their `index`)
  fun images_in(ctxt, secs):
    context_ref_all(ctxt, #'image)
      .filter(~keep: fun (e): section_of(e, secs))
      .sort(fun (a, b): index_less(expr_index(a), expr_index(b)))
  fun image_path(e):
    match e | 'image $p': to_string(p.unwrap()) | ~else: ""

meta:
  // the performer timeline for a context, as `PairList(...)` syntax -- factored
  // out of the realizer so `nav_audios` can build one per face in a single pass
  fun performer_timeline(ctxt):
    def sr = 44100.0
    // seconds per interval unit: one unit is a quarter, ~120 bpm
    def spu = 0.5
    // a lexical context for generated literals (so string/number literals
    // resolve `#%literal` in the module the timeline is spliced into);
    // borrow it from any form in scope
    def ctx0 = head_id_of(ctxt[0])
    fun str(s): Syntax.make(s, ctx0)
    def events = for values(acc = []) (secs in sections_by_index(ctxt)):
      def label = first_string_in(ctxt, #'art_title, secs) || sec_label(secs)
      def mark = 'PairList("mark", $(str(label)))'
      // one script block -> its speak/direct events, in line order
      fun script_events(sc):
        for values(a = []) (it in (sc.group_property(#'inner) || [])):
          cond
          | head_of(it) == #'line:
              def sp = str(mrkt.#{string-upcase}(to_string(args_of(it)[0].unwrap())))
              def tx = str(to_string(args_of(it)[1].unwrap()))
              a ++ ['PairList("speak", $sp, $tx)']
          | head_of(it) == #'stage_direction:
              def tx = str(to_string(args_of(it)[0].unwrap()))
              a ++ ['PairList("direct", $tx)']
          | ~else: a
      // a set of tones -> one `music` event (mixed with rs_render, as a thunk)
      fun music_event(toneset):
        if toneset.length() > 0
        | (block:
             fun lit(v): Syntax.make(v, head_id_of(toneset[0]))
             fun frames(x): lit(mrkt.#{inexact->exact}(math.round(x)))
             def specs = for List (t in toneset):
               def start = expr_start(t)
               def end = expr_end(t)
               def vs = context_ref_surrounding(ctxt, get_ctxt(t), #'volume)
               def vol = if vs.length() > 0 | args_of(vs[0])[0].unwrap() | 1
               '[$(lit(args_of(t)[0].unwrap())), $(lit(vol * 0.05)), $(frames((end - start) * sr * spu)), $(frames(start * sr * spu))]'
             def maxend = for values(m = 0) (t in toneset):
               def e = expr_end(t)
               if e && e > m | e | m
             let [sp, ...] = specs
             ['PairList("music", fun (): rs_render([$sp, ...]), $(lit(maxend * spu)))'])
        | []
      // the section's slides (if any) -> one `slide` event with their paths
      def imgs = images_in(ctxt, secs)
      def slide_evs:
        if imgs.length() > 0
        | (block:
             def paths = for List (im in imgs): str(image_path(im))
             let [p, ...] = paths
             ['PairList("slide", PairList($p, ...))'])
        | []
      // Order a section's speak and music by their `index` coordinate, the way
      // art3's `the-script` was one `ix--` of speak/output items -- so a fanfare
      // written as ix__ item 1 plays right after the line that is item 0.  Each
      // script block and each `music` embedding is a chunk tagged with its index
      // (or #false); unindexed chunks keep their input order after the indexed
      // ones, so a section without `ix__` behaves exactly as before.
      def big = 1000000000
      // an item's full `index` path (art3's nested ix-- gives [9 0 1]); the
      // whole path matters, not just its head, since sibling items share a
      // prefix.  Unindexed chunks get [big] so they sort after indexed ones.
      fun idx_key(e):
        def ix = expr_index(e)
        if ix.length() > 0 | ix | [big]
      fun lex_less(a, b):
        def n = math.min(a.length(), b.length())
        recur loop(i = 0):
          cond
          | i == n: a.length() < b.length()   // a prefix of b sorts first
          | a[i] < b[i]: #true
          | a[i] > b[i]: #false
          | ~else: loop(i + 1)
      def script_chunks = for List (sc in scripts_in(ctxt, secs)):
        [idx_key(sc), script_events(sc)]
      // Group the section's tones by the `index` of the `music` embedding they
      // sit in (bare tones -- e.g. a hymn score from `hymn_number_to_score` --
      // key as [big]).  Tones sharing an index MIX into one event (a dance's
      // melody + accompaniment play together); distinct indices stay separate (a
      // fanfare interleaved with the script by its ix__ position).  Groups are
      // kept in FIRST-APPEARANCE order so unindexed music ([big]) stays in the
      // order it was written -- a MutableMap's key order is arbitrary and shuffled
      // the samples visually.
      fun tone_id(t): to_string(art_id_of(t))
      // per-embedding tone lists in appearance order, plus a trailing entry for
      // bare tones
      def raw_groups:
        def per_embed = for List (m in musics_in(ctxt, secs)): [idx_key(m), tones_of(m)]
        def embedded_ids:
          for values(acc = []) (m in musics_in(ctxt, secs)):
            acc ++ tones_of(m).map(tone_id)
        fun is_embedded(t):
          for values(f = #false) (id in embedded_ids): f || (id == tone_id(t))
        def bare_tones = tones_in(ctxt, secs).filter(~keep: fun (t): !is_embedded(t))
        if bare_tones.length() > 0 | per_embed ++ [[[big], bare_tones]] | per_embed
      // merge same-index entries, preserving the order each key first appears
      def merged:
        for values(acc = []) (e in raw_groups):
          def ks = to_string(e[0])
          if acc.filter(~keep: fun (g): to_string(g[0]) == ks).length() > 0
          | acc.map(fun (g): if to_string(g[0]) == ks | [g[0], g[1] ++ e[1]] | g)
          | acc ++ [e]
      def music_chunks = for List (g in merged): [g[0], music_event(g[1])]
      def slide_chunks = if slide_evs.length() > 0 | [[[big], slide_evs]] | []
      def all_chunks = script_chunks ++ slide_chunks ++ music_chunks
      def tagged = for List (i in 0 .. all_chunks.length()):
        [all_chunks[i][0], i, all_chunks[i][1]]
      def sorted = tagged.sort(fun (a, b):
                                 cond
                                 | lex_less(a[0], b[0]): #true
                                 | lex_less(b[0], a[0]): #false
                                 | ~else: a[1] < b[1])
      def body_evs = for values(a = []) (t in sorted): a ++ t[2]
      acc ++ [mark] ++ body_evs
    let [ev, ...] = events
    'PairList($ev, ...)'

  // a face's coordinates as a readable selector string (matches scribble.rhm's
  // nav_views keys, so a view and its audio pair up by selector)
  fun nav_coord_text(c):
    def parts = args_of(c).map(fun (a): to_string(a.unwrap()))
    to_string(head_of(c)) +& (if parts.length() > 0 | " " +& join(parts, " ") | "")
  fun nav_selector(e):
    def cs = get_ctxt(e).filter(~keep: fun (c): to_string(head_of(c)) != "art_id")
    join(cs.map(nav_coord_text), ", ")

define_realizer program_performer:
  fun (ctxt): performer_timeline(ctxt)

// nav_audios: for EVERY art_program in scope, realize its performance timeline
// in ONE pass, keyed by its coordinate selector.  Reduce the composition's
// recipe-applied AUDIO program (generative objects sampled to notes) to reach
// this context; each face's html is converted to tones and performed here, so
// the preview gets all face audio from a single realize -- O(faces), not the
// O(faces^2) of reducing the whole scene per face.  Returns a list of
// PairList(SELECTOR, TIMELINE); a timeline's music is a thunk, so it stays lazy.
define_realizer nav_audios:
  fun (ctxt):
    def aps = context_ref_all(ctxt, #'art_program)
    def rows = for List (ap in aps):
      def sub = program_pick(ap, #'html)
      def facectxt = rewrite(sub ++ ['rewrite_nested: note_to_tone'])
      def sel = Syntax.make(nav_selector(ap), head_id_of(ap))
      def tl = performer_timeline(facectxt)
      'PairList($sel, $tl)'
    let [r, ...] = rows
    'PairList($r, ...)'
