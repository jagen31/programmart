#lang rhombus/and_meta

// programmart's Scribble realizer: a concert program whose sections carry
// engraved scores (from hymn numbers) and background colours.  Requires
// the `lilypond` CLI (to engrave) and `raco` (to render); scores are
// written under ./program-scores/.

import:
  programmart open
  lib("tonart4/main.rhm") open
  lib("programmart/hymnal.rhm") open
  lib("programmart/scribble.rhm") open

define_art order_of_service:
  program_title "Sunday Service"
  at [section prelude]:
    art_title "Prelude"
    hymn_number 1
  at [section opening_song]:
    art_title "Opening Song"
    hymn_number 9

define_art color_program:
  at [section prelude]:      bg "goldenrod"
  at [section opening_song]: bg "lightblue"

def src = realize program_scribble:
            order_of_service
            color_program
            hymn_number_to_score
println("=== Scribble source (colored sections + engraved hymn scores) ===")
println(src)
// render to HTML:  render_scribble_html(src, "program-scores", "program")
