#lang rhombus/and_meta

// =====================================================================
// programmart/dance -- bridge danceart poses onto the concert program.
//
// The Scribble realizer (and `program_png_pict`) render `image` objects, never
// `arm_diagram` directly.  `arm_diagram_to_image` renders each `arm_diagram`
// pose to a PNG (via danceart's `render_dancer`) and replaces it with an
// `image` carrying the pose's coordinates -- so the dancer figures hang over
// the staves in the engraved program, exactly as the old concert did.
//
//   import:
//     lib("programmart/dance.rhm") open
//   ... a program that contains `at [...]: arm_diagram L R` poses ...
//   arm_diagram_to_image     // run before realizing to Scribble / a pict
// =====================================================================

import:
  danceart open                       // arm_diagram, facing, render_dancer (meta)
  lib("tonart4/lilypond.rhm") open    // the `image` object the renderer reads
  meta:
    lib("racket/base.rkt") as mrkt

export:
  arm_diagram_to_image

define_mapping_rewriter arm_diagram_to_image over arm_diagram:
  fun (stx, ap):
    // EPS, not PNG: the engraver embeds it with \epsfile, which keeps the
    // figure's transparency and colours (lilypond silently drops transparent
    // PNGs).  PNG is danceart's HTML format.
    def rel = render_dancer(ap, "dance-figures", "eps")
    if rel
    | (block:
        // lilypond engraves in its own working dir, so the `\image` reference
        // must be ABSOLUTE or the figure is silently dropped from the score
        def abs = mrkt.#{path->string}(mrkt.#{path->complete-path}(rel))
        [set_ctxt('image $(Syntax.make(abs))',
                  remove_from_ctxt(get_ctxt(ap), #'art_id))])
    | []
