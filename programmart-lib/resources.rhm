#lang rhombus/and_meta

// =====================================================================
// programmart -- resources and the multi-realizer art_program.
//
//   art_program: name: prog; ...   an embedding holding one sub-program
//                                   per realizer; `pick_program name`
//                                   selects one and splices it
//
//   resource_row name "title" "author": contents   a row of a resource
//   resource name                                   reference a resource
//   resource_to_title / resource_to_contents        expand a reference
//
// A "resource" is the general form of a program item: named content held
// in a table, referenced by name so the program mentions it without
// printing the whole thing inline.  Ported from the concert's datenart
// resource table, minus the SQL machinery.
// =====================================================================

import: programmart open

export:
  resource_row resource program_rule
  resource_to_title resource_to_contents drop_resource_rows
  meta:
    resources_of row_name row_title
    row_author row_contents lookup_row title_string

// `art_program` (+ pick_program / rewrite_in_program and their helpers
// splice_under / program_variants / program_pick / rebuild_art_program) now
// live in the programmart standard lib (private/lib.rhm), imported open above.

// ---------------------------------------------------------------------
// resources
// ---------------------------------------------------------------------

// a row of the resource table: name, printed title, author, and contents
// (held as the block body).  `resources` bundles rows into scope.
define_embedding resource_row:
  fun (expr): rewrite(body_of(expr))

define_object resource        // resource name  (a reference)
define_object program_rule    // a thick rule under a resource's heading

meta:
  fun resources_of(ctxt):
    context_ref_all(ctxt, #'resource_row)
  fun row_name(r):
    match r | 'resource_row $n $_ ...': n.unwrap() | ~else: #false
  fun row_title(r):
    match r | 'resource_row $_ $t $_ ...': t.unwrap() | ~else: ""
  fun row_author(r):
    match r | 'resource_row $_ $_ $a $_ ...': a.unwrap() | ~else: ""
  fun row_contents(r): r.group_property(#'inner) || []
  // the row whose name matches, or #false
  fun lookup_row(ctxt, n):
    def rs = resources_of(ctxt).filter(~keep: fun (r): row_name(r) == n)
    if rs.length() > 0 | rs[0] | #false
  // "Author — Title", or just the title when there is no author
  fun title_string(r):
    def t = row_title(r)
    def a = row_author(r)
    if a == "" | t | a +& " — " +& t

// resource name  ->  a `text` line with the resource's title (the line a
// program shows in place of the contents), keeping the reference's coords
define_mapping_rewriter resource_to_title over resource:
  fun (stx, res):
    def row = lookup_row(current_ctxt(), args_of(res)[0].unwrap())
    if row
    | (block: def s = Syntax.make(title_string(row)); [set_ctxt('text $s', get_ctxt(res))])
    | []

// resource name  ->  the resource's contents, spliced under its title,
// carrying the reference's coordinates (e.g. its section)
define_mapping_rewriter resource_to_contents over resource:
  fun (stx, res):
    def row = lookup_row(current_ctxt(), args_of(res)[0].unwrap())
    def coords = remove_from_ctxt(get_ctxt(res), #'art_id)
    if row
    | (block:
         def s = Syntax.make(title_string(row))
         // heading, a thick rule, then the embedded program's contents
         splice_under(coords, ['text $s', 'program_rule'] ++ row_contents(row)))
    | []

// drop_resource_rows: remove every `resource_row` from the context.  A row
// holds its contents RAW so `resource_to_contents` can splice them in under a
// referencing section; left in place, that raw content renders as an
// unsectioned blob (e.g. a prelude's whole score) on every page that has the
// rows in scope.  Run this AFTER resource_to_contents / resource_to_title
// (which read the rows) to clear the leftovers.
define_rewriter drop_resource_rows:
  fun (stx):
    [delete_exprs(context_ref_all(current_ctxt(), #'resource_row))]
